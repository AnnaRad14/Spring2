<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean id="mySpaceship" class="ex3.Spaceship" init-method="initShip">

        <constructor-arg value="Falcon 9" />

        <property name="speed" value="28000" />

    </bean>

    <bean id="myDictionary" class="ex4.Dictionary">
        <property name="terms">
            <map>
                <entry key="IoC" value="Inversion of Control (Інверсія керування)" />
                <entry key="DI" value="Dependency Injection (Впровадження залежностей)" />
                <entry key="Bean" value="Об'єкт, яким керує Spring Container" />
            </map>
        </property>
    </bean>

</beans>